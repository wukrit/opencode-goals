{
  "name": "opencode2-goals",
  "version": "1.0.1",
  "description": "OpenCode v2 plugin: a durable, session-scoped goal loop with evidence-gated completion, budget caps, and an unattended permission sandbox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wukrit/opencode2-goals.git"
  },
  "homepage": "https://github.com/wukrit/opencode2-goals#readme",
  "bugs": {
    "url": "https://github.com/wukrit/opencode2-goals/issues"
  },
  "type": "module",
  "license": "Unlicense",
  "exports": {
    ".": "./index.ts",
    "./rpc": "./src/rpc.ts",
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "index.ts",
    "tui.tsx",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tui.json",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "goals",
    "agent-loop"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.15",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@opentui/core": "^0.5.12",
    "@opentui/solid": "^0.5.12",
    "solid-js": "^1.9.12"
  },
  "peerDependenciesMeta": {
    "@opentui/core": { "optional": true },
    "@opentui/solid": { "optional": true },
    "solid-js": { "optional": true }
  }
}
